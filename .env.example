VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_APP_NAME=SPET Online
VITE_APP_URL=https://your-site.netlify.app
VITE_MAPBOX_TOKEN=your-mapbox-public-key-here

# ─── Netlify server-side secrets (never expose to the browser) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-key
# optional: model for the storefront chat (default claude-opus-5-5; claude-haiku-5-5 is far cheaper)
CLAUDE_CHAT_MODEL=
# optional: where the daily visitor report goes (default SENDER_EMAIL)
AI_REPORT_EMAIL=
SITE_URL=https://your-site.netlify.app

# ─── payment / email / ERP integrations ──
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
BREVO_API_KEY=
SENDER_EMAIL=sales@spetonline.co.za
SENDER_NAME=SPET Online

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ORGANIZATION_ID=
ZOHO_REDIRECT_URI=https://your-site.netlify.app/.netlify/functions/zoho-callback

# ─── SFTP sync jobs ──
AXIZ_SFTP_HOST=
AXIZ_SFTP_USER=
AXIZ_SFTP_PASSWORD=
AXIZ_SFTP_PATH=/home/axizpricing/files

# ─── scripts/generate-descriptions.mjs (local-only, never exposed to the client) ──
# same values as above if you run the generator locally
